# release published, new Zenodo version DOI confirmed live below. This file now describes that
# release, not v1.0.0 -- the same discipline as the 2026-09-08 update: only updated once the real
# event happened, never guessed or bumped in advance.
date-released: "2026-09-10"
version: 1.0.3
